<AdmiralMenu AriaLabel="@AriaLabel" MatchTriggerWidth="@MatchTriggerWidth" Class="@MenuClass">
    <Trigger>
        <AdmiralButton Text="@Text" IconStart="@IconStart" IconEnd="admiral:system/chevron-down-outline"
                       Appearance="@Appearance" Dimension="@Dimension" Disabled="@Disabled" />
    </Trigger>
    <ChildContent>@ChildContent</ChildContent>
</AdmiralMenu>

@code {
    [Parameter] public string Text { get; set; } = "Menu";
    [Parameter] public string? IconStart { get; set; }
    [Parameter] public AdmiralButtonAppearance Appearance { get; set; }
    [Parameter] public AdmiralButtonDimension Dimension { get; set; } = AdmiralButtonDimension.Xl;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool MatchTriggerWidth { get; set; } = true;
    [Parameter] public string AriaLabel { get; set; } = "Menu";
    [Parameter] public string? MenuClass { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
