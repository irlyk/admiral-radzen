<AdmiralInputField Label="@Label" AdditionalLabel="@AdditionalLabel" ExtraText="@ExtraText"
                   For="@Id" Required="@Required" Size="@Size" Status="@Status" Class="@Class">
    <AdmiralTextArea Value="@Value" ValueChanged="@ValueChanged" ValueExpression="@ValueExpression"
                     Copied="@Copied" Name="@Name" Id="@Id" Placeholder="@Placeholder" Size="@Size" Status="@Status"
                     Rows="@Rows" MinRows="@MinRows" MaxRows="@MaxRows" MaxLength="@MaxLength"
                     AutoHeight="@AutoHeight" Resizable="@Resizable" DisplayClearIcon="@DisplayClearIcon"
                     DisplayCopyIcon="@DisplayCopyIcon" Disabled="@Disabled" ReadOnly="@ReadOnly" Loading="@Loading"
                     Skeleton="@Skeleton" Immediate="@Immediate" ClearAriaLabel="@ClearAriaLabel"
                     CopyAriaLabel="@CopyAriaLabel" Style="@Style" @attributes="@AdditionalAttributes" />
</AdmiralInputField>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public System.Linq.Expressions.Expression<Func<string?>>? ValueExpression { get; set; }
    [Parameter] public EventCallback Copied { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? AdditionalLabel { get; set; }
    [Parameter] public string? ExtraText { get; set; }
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public AdmiralInputSize Size { get; set; } = AdmiralInputSize.Medium;
    [Parameter] public AdmiralInputStatus Status { get; set; }
    [Parameter] public int Rows { get; set; } = 3;
    [Parameter] public int MinRows { get; set; } = 3;
    [Parameter] public int MaxRows { get; set; } = 8;
    [Parameter] public long? MaxLength { get; set; }
    [Parameter] public bool AutoHeight { get; set; }
    [Parameter] public bool Resizable { get; set; }
    [Parameter] public bool DisplayClearIcon { get; set; }
    [Parameter] public bool DisplayCopyIcon { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Skeleton { get; set; }
    [Parameter] public bool Immediate { get; set; } = true;
    [Parameter] public string ClearAriaLabel { get; set; } = "Clear value";
    [Parameter] public string CopyAriaLabel { get; set; } = "Copy value";
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
