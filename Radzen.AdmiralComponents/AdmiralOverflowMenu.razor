<AdmiralMenu AriaLabel="@AriaLabel" Class="@MenuClass">
    <Trigger>
        <AdmiralIconButton Icon="@Icon" AriaLabel="@AriaLabel" Appearance="@Appearance"
                           Dimension="@Dimension" Disabled="@Disabled" />
    </Trigger>
    <ChildContent>@ChildContent</ChildContent>
</AdmiralMenu>

@code {
    [Parameter] public string Icon { get; set; } = "admiral:system/more-horizontal-outline";
    [Parameter] public string AriaLabel { get; set; } = "More actions";
    [Parameter] public AdmiralIconButtonAppearance Appearance { get; set; } = AdmiralIconButtonAppearance.Secondary;
    [Parameter] public AdmiralButtonDimension Dimension { get; set; } = AdmiralButtonDimension.M;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? MenuClass { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
