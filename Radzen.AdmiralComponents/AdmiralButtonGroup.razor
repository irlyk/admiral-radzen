<div class="@CssClass" role="group" aria-label="@AriaLabel"
     data-dimension="@Dimension.ToString().ToLowerInvariant()"
     data-appearance="@Appearance.ToString().ToLowerInvariant()"
     @attributes="AdditionalAttributes">
    <CascadingValue Value="this">@ChildContent</CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public AdmiralButtonGroupAppearance Appearance { get; set; }
    [Parameter] public AdmiralButtonDimension Dimension { get; set; } = AdmiralButtonDimension.Xl;
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    internal AdmiralButtonAppearance ButtonAppearance => Appearance switch
    {
        AdmiralButtonGroupAppearance.Secondary => AdmiralButtonAppearance.Secondary,
        AdmiralButtonGroupAppearance.Tertiary => AdmiralButtonAppearance.Tertiary,
        _ => AdmiralButtonAppearance.Primary
    };

    private string CssClass => string.Join(' ', new[]
    {
        "admiral-button-group",
        $"admiral-button-group--{Appearance.ToString().ToLowerInvariant()}",
        Class
    }.Where(value => !string.IsNullOrWhiteSpace(value)));
}
