@typeparam TItem where TItem : notnull

@if (DividerBefore)
{
    <span class="admiral-data-grid__action-divider" aria-hidden="true"></span>
}

<RadzenButton class="@CssClass"
              Text="@Text" Icon="@Icon"
              Variant="Variant.Text" ButtonStyle="@ButtonStyle"
              Size="@EffectiveSize" Disabled="@IsEffectivelyDisabled"
              aria-label="@EffectiveAriaLabel"
              Click="HandleClick" />

@code {
    [CascadingParameter(Name = "AdmiralDataGridRowItem")] public TItem? Item { get; set; }
    [CascadingParameter(Name = "AdmiralDataGridRowActionSize")] public ButtonSize? GridSize { get; set; }

    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;
    [Parameter] public string? Text { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public Func<TItem, string>? AriaLabelFor { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public Func<TItem, bool>? DisabledFor { get; set; }
    [Parameter] public bool DividerBefore { get; set; }
    [Parameter] public ButtonStyle ButtonStyle { get; set; } = ButtonStyle.Primary;
    [Parameter] public ButtonSize? Size { get; set; }
    [Parameter] public EventCallback<TItem> Click { get; set; }
    [Parameter] public string? Class { get; set; }

    private ButtonSize EffectiveSize => Size ?? GridSize ?? ButtonSize.Small;
    private bool IsEffectivelyDisabled => Disabled || (Item is not null && DisabledFor?.Invoke(Item) == true);
    private string EffectiveAriaLabel => Item is not null && AriaLabelFor is not null
        ? AriaLabelFor(Item)
        : AriaLabel ?? Text ?? string.Empty;
    private string CssClass => string.Join(' ', new[]
    {
        string.IsNullOrWhiteSpace(Text) ? "admiral-icon-button" : "admiral-text-button",
        Class
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private Task HandleClick(MouseEventArgs _) => Item is null
        ? Task.CompletedTask
        : Click.InvokeAsync(Item);
}
