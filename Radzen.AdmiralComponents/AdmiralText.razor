@switch (Tag)
{
    case AdmiralTextTag.Div: <div class="@CssClass" style="@CssStyle" @attributes="AdditionalAttributes">@ChildContent</div> break;
    case AdmiralTextTag.Paragraph: <p class="@CssClass" style="@CssStyle" @attributes="AdditionalAttributes">@ChildContent</p> break;
    case AdmiralTextTag.H1: <h1 class="@CssClass" style="@CssStyle" @attributes="AdditionalAttributes">@ChildContent</h1> break;
    case AdmiralTextTag.H2: <h2 class="@CssClass" style="@CssStyle" @attributes="AdditionalAttributes">@ChildContent</h2> break;
    case AdmiralTextTag.H3: <h3 class="@CssClass" style="@CssStyle" @attributes="AdditionalAttributes">@ChildContent</h3> break;
    case AdmiralTextTag.H4: <h4 class="@CssClass" style="@CssStyle" @attributes="AdditionalAttributes">@ChildContent</h4> break;
    case AdmiralTextTag.H5: <h5 class="@CssClass" style="@CssStyle" @attributes="AdditionalAttributes">@ChildContent</h5> break;
    case AdmiralTextTag.H6: <h6 class="@CssClass" style="@CssStyle" @attributes="AdditionalAttributes">@ChildContent</h6> break;
    default: <span class="@CssClass" style="@CssStyle" @attributes="AdditionalAttributes">@ChildContent</span> break;
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public AdmiralTypography Typography { get; set; } = AdmiralTypography.Body1Long;
    [Parameter] public AdmiralTextTag Tag { get; set; }
    [Parameter] public string? Color { get; set; }
    [Parameter] public bool Skeleton { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => string.Join(' ', new[]
    {
        "admiral-text", $"admiral-text--{Typography.ToString().ToLowerInvariant()}",
        Skeleton ? "rz-skeleton admiral-text--skeleton" : null, Class
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private string CssStyle => string.Join(' ', new[]
    {
        string.IsNullOrWhiteSpace(Color) ? null : $"color: {Color};", Style
    }.Where(value => !string.IsNullOrWhiteSpace(value)));
}
