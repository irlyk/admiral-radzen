<div class="@CssClass" data-status="@StatusName" aria-busy="@(Loading ? "true" : null)">
    <RadzenTextBox Value="@Value"
                   ValueChanged="@HandleValueChanged"
                   ValueExpression="@ValueExpression"
                   Name="@Name"
                   Placeholder="@Placeholder"
                   Disabled="@(Disabled || Loading)"
                   ReadOnly="@ReadOnly"
                   MaxLength="@MaxLength"
                   Immediate="@Immediate"
                   Trim="@Trim"
                   class="admiral-text-input__control"
                   @attributes="EffectiveAttributes" />

    @if (!string.IsNullOrWhiteSpace(IconStart))
    {
        <span class="admiral-text-input__leading" aria-hidden="true">
            <AdmiralIcon Icon="@IconStart" Size="@IconSize" />
        </span>
    }

    @if (HasTrailingContent)
    {
        <span class="admiral-text-input__trailing">
            @if (!string.IsNullOrWhiteSpace(IconEnd))
            {
                <AdmiralIcon Icon="@IconEnd" Size="@IconSize" aria-hidden="true" />
            }
            @if (Loading)
            {
                <AdmiralSpinner Size="@SpinnerSize" AriaLabel="Loading" />
            }
            else
            {
                @if (ShowClearAction)
                {
                    <button type="button" class="admiral-text-input__action" aria-label="@ClearAriaLabel"
                            @onmousedown:preventDefault @onclick="ClearAsync">
                        <AdmiralIcon Icon="admiral:service/close-outline" Size="@IconSize" aria-hidden="true" />
                    </button>
                }
                @if (Password)
                {
                    <button type="button" class="admiral-text-input__action" aria-label="@PasswordAriaLabel"
                            disabled="@(Disabled || ReadOnly)" @onmousedown:preventDefault @onclick="TogglePassword">
                        <AdmiralIcon Icon="@(passwordVisible ? "admiral:service/eye-close-outline" : "admiral:service/eye-outline")"
                                     Size="@IconSize" aria-hidden="true" />
                    </button>
                }
            }
        </span>
    }
</div>

@code {
    private bool passwordVisible;

    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public System.Linq.Expressions.Expression<Func<string?>>? ValueExpression { get; set; }
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public AdmiralInputSize Size { get; set; } = AdmiralInputSize.Medium;
    [Parameter] public AdmiralInputStatus Status { get; set; }
    [Parameter] public string? IconStart { get; set; }
    [Parameter] public string? IconEnd { get; set; }
    [Parameter] public bool DisplayClearIcon { get; set; }
    [Parameter] public bool Password { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Skeleton { get; set; }
    [Parameter] public bool Immediate { get; set; } = true;
    [Parameter] public bool Trim { get; set; }
    [Parameter] public long? MaxLength { get; set; }
    [Parameter] public string ClearAriaLabel { get; set; } = "Clear value";
    [Parameter] public string ShowPasswordAriaLabel { get; set; } = "Show password";
    [Parameter] public string HidePasswordAriaLabel { get; set; } = "Hide password";
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string StatusName => Status.ToString().ToLowerInvariant();
    private bool ShowClearAction => DisplayClearIcon && !string.IsNullOrEmpty(Value) && !Disabled && !ReadOnly;
    private bool HasTrailingContent => !string.IsNullOrWhiteSpace(IconEnd) || Loading || ShowClearAction || Password;
    private string PasswordAriaLabel => passwordVisible ? HidePasswordAriaLabel : ShowPasswordAriaLabel;
    private AdmiralIconSize IconSize => Size == AdmiralInputSize.Small ? AdmiralIconSize.Medium : AdmiralIconSize.Large;
    private AdmiralSpinnerSize SpinnerSize => Size == AdmiralInputSize.Small ? AdmiralSpinnerSize.MediumSmall : AdmiralSpinnerSize.Medium;

    private IReadOnlyDictionary<string, object> EffectiveAttributes
    {
        get
        {
            var attributes = AdditionalAttributes is null
                ? new Dictionary<string, object>()
                : new Dictionary<string, object>(AdditionalAttributes);
            if (!string.IsNullOrWhiteSpace(Id)) attributes["id"] = Id;
            if (Password) attributes["type"] = passwordVisible ? "text" : "password";
            if (Status == AdmiralInputStatus.Error && !attributes.ContainsKey("aria-invalid"))
            {
                attributes["aria-invalid"] = "true";
            }
            return attributes;
        }
    }

    private Task HandleValueChanged(string value) => ValueChanged.InvokeAsync(value);
    private Task ClearAsync() => ValueChanged.InvokeAsync(string.Empty);
    private void TogglePassword() => passwordVisible = !passwordVisible;

    private string CssClass => string.Join(' ', new[]
    {
        "admiral-text-input",
        $"admiral-text-input--{Size switch { AdmiralInputSize.Small => "s", AdmiralInputSize.ExtraLarge => "xl", _ => "m" }}",
        Status == AdmiralInputStatus.Default ? null : $"admiral-text-input--{StatusName}",
        !string.IsNullOrWhiteSpace(IconStart) ? "admiral-text-input--with-leading" : null,
        HasTrailingContent ? $"admiral-text-input--trailing-{TrailingCount}" : null,
        Skeleton ? "rz-skeleton admiral-text-input--skeleton" : null,
        Class
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private int TrailingCount =>
        (string.IsNullOrWhiteSpace(IconEnd) ? 0 : 1) +
        (Loading || ShowClearAction ? 1 : 0) +
        (!Loading && Password ? 1 : 0);
}
