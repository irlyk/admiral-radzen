@typeparam TValue
@typeparam TItem
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

<AdmiralInputField Label="@Label" AdditionalLabel="@AdditionalLabel" ExtraText="@ExtraText"
                   For="@controlId" Required="@Required" Size="@Size" Status="@Status" Class="@Class" @ref="inputField">
    <AdmiralSelect TValue="TValue" TItem="TItem" Value="@Value" ValueChanged="@ValueChanged"
                   Values="@Values" ValuesChanged="@ValuesChanged"
                   ValueExpression="@ValueExpression" Name="@EffectiveName" Data="@Data"
                   id="@controlId" aria-labelledby="@(string.IsNullOrWhiteSpace(Label) ? null : $"{controlId}-label")"
                   aria-invalid="@(Status == AdmiralInputStatus.Error ? "true" : null)"
                   TextSelector="@TextSelector" ValueSelector="@ValueSelector" DisabledSelector="@DisabledSelector"
                   GroupSelector="@GroupSelector" ItemTemplate="@ItemTemplate" SelectedTemplate="@SelectedTemplate"
                   Placeholder="@Placeholder" FilterPlaceholder="@FilterPlaceholder" Size="@Size" Status="@Status"
                   AllowFiltering="@AllowFiltering" AllowClear="@AllowClear" Disabled="@Disabled" ReadOnly="@ReadOnly"
                   Multiple="@Multiple" Chips="@Chips" AllowSelectAll="@AllowSelectAll" Separator="@Separator"
                   Loading="@Loading" Skeleton="@Skeleton" />
</AdmiralInputField>

@code {
    private readonly string controlId = $"admiral-select-{Guid.NewGuid():N}";
    private AdmiralInputField? inputField;
    private string EffectiveName => string.IsNullOrWhiteSpace(Name) ? $"{controlId}-value" : Name;

    protected override void OnAfterRender(bool firstRender)
    {
        if (inputField is not null)
        {
            inputField.LabelFocusFallback = FocusControlAsync;
        }
    }

    private Task FocusControlAsync()
    {
        if (Disabled || Loading)
        {
            return Task.CompletedTask;
        }

        return JSRuntime.InvokeVoidAsync("Radzen.focusElement", controlId).AsTask();
    }

    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }
    [Parameter] public IEnumerable<TValue>? Values { get; set; }
    [Parameter] public EventCallback<IEnumerable<TValue>?> ValuesChanged { get; set; }
    [Parameter] public System.Linq.Expressions.Expression<Func<TValue?>>? ValueExpression { get; set; }
    [Parameter] public IEnumerable<TItem>? Data { get; set; }
    [Parameter] public Func<TItem, string>? TextSelector { get; set; }
    [Parameter] public Func<TItem, TValue?>? ValueSelector { get; set; }
    [Parameter] public Func<TItem, string?>? GroupSelector { get; set; }
    [Parameter] public Func<TItem, bool>? DisabledSelector { get; set; }
    [Parameter] public RenderFragment<TItem>? ItemTemplate { get; set; }
    [Parameter] public RenderFragment<TItem>? SelectedTemplate { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? AdditionalLabel { get; set; }
    [Parameter] public string? ExtraText { get; set; }
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? FilterPlaceholder { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public AdmiralInputSize Size { get; set; } = AdmiralInputSize.Medium;
    [Parameter] public AdmiralInputStatus Status { get; set; }
    [Parameter] public bool AllowFiltering { get; set; }
    [Parameter] public bool AllowClear { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Multiple { get; set; }
    [Parameter] public bool Chips { get; set; }
    [Parameter] public bool AllowSelectAll { get; set; } = true;
    [Parameter] public bool Skeleton { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string Separator { get; set; } = ", ";
    [Parameter] public string? Class { get; set; }
}
