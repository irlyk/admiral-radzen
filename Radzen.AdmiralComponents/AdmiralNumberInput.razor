@typeparam TValue

<div class="@CssClass" data-status="@StatusName">
    <RadzenNumeric TValue="TValue"
                   Value="@Value"
                   ValueChanged="@ValueChanged"
                   ValueExpression="@ValueExpression"
                   Name="@Name"
                   Placeholder="@Placeholder"
                   Disabled="@Disabled"
                   ReadOnly="@ReadOnly"
                   Min="@Min"
                   Max="@Max"
                   Step="@Step"
                   Format="@EffectiveFormat"
                   ShowUpDown="@DisplayPlusMinusIcons"
                   TextAlign="@EffectiveTextAlign"
                   Immediate="@Immediate"
                   MaxLength="@MaxLength"
                   UpAriaLabel="@IncreaseAriaLabel"
                   DownAriaLabel="@DecreaseAriaLabel"
                   InputAttributes="@EffectiveInputAttributes"
                   class="admiral-number-input__control"
                   @attributes="AdditionalAttributes" />
    @if (ShowClearAction)
    {
        <button type="button" class="admiral-number-input__clear" aria-label="@ClearAriaLabel"
                @onmousedown:preventDefault @onclick="ClearAsync">
            <AdmiralIcon Icon="admiral:service/close-outline" Size="@IconSize" aria-hidden="true" />
        </button>
    }
</div>

@code {
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }
    [Parameter] public System.Linq.Expressions.Expression<Func<TValue?>>? ValueExpression { get; set; }
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public AdmiralInputSize Size { get; set; } = AdmiralInputSize.Medium;
    [Parameter] public AdmiralInputStatus Status { get; set; }
    [Parameter] public AdmiralNumberInputAlignment Alignment { get; set; }
    [Parameter] public decimal? Min { get; set; }
    [Parameter] public decimal? Max { get; set; }
    [Parameter] public string Step { get; set; } = "1";
    [Parameter] public int Precision { get; set; } = 2;
    [Parameter] public string? Prefix { get; set; }
    [Parameter] public string? Suffix { get; set; }
    [Parameter] public string? TextBefore { get; set; }
    [Parameter] public string? TextAfter { get; set; }
    [Parameter] public string? Format { get; set; }
    [Parameter] public bool DisplayPlusMinusIcons { get; set; } = true;
    [Parameter] public bool DisplayClearIcon { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Skeleton { get; set; }
    [Parameter] public bool Immediate { get; set; } = true;
    [Parameter] public long? MaxLength { get; set; }
    [Parameter] public string IncreaseAriaLabel { get; set; } = "Increase value";
    [Parameter] public string DecreaseAriaLabel { get; set; } = "Decrease value";
    [Parameter] public string ClearAriaLabel { get; set; } = "Clear value";
    [Parameter] public string? Class { get; set; }
    [Parameter] public IReadOnlyDictionary<string, object>? InputAttributes { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool ShowClearAction => DisplayClearIcon && Value is not null && !Disabled && !ReadOnly;
    private string StatusName => Status.ToString().ToLowerInvariant();
    private AdmiralIconSize IconSize => Size == AdmiralInputSize.Small ? AdmiralIconSize.Medium : AdmiralIconSize.Large;
    private TextAlign EffectiveTextAlign => Alignment == AdmiralNumberInputAlignment.Right ? TextAlign.Right : TextAlign.Left;
    private string EffectiveFormat => Format ?? $"{Literal(TextBefore ?? Prefix)}#,##0{(Precision > 0 ? "." + new string('0', Precision) : string.Empty)}{Literal(TextAfter ?? Suffix)}";

    private IReadOnlyDictionary<string, object>? EffectiveInputAttributes
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Id) && Status != AdmiralInputStatus.Error) return InputAttributes;
            var attributes = InputAttributes is null ? new Dictionary<string, object>() : new(InputAttributes);
            if (!string.IsNullOrWhiteSpace(Id)) attributes["id"] = Id;
            if (Status == AdmiralInputStatus.Error && !attributes.ContainsKey("aria-invalid")) attributes["aria-invalid"] = "true";
            return attributes;
        }
    }

    private static string Literal(string? value) => string.IsNullOrEmpty(value) ? string.Empty : $"'{value.Replace("'", "''")}'";
    private Task ClearAsync() => ValueChanged.InvokeAsync(default);

    private string CssClass => string.Join(' ', new[]
    {
        "admiral-number-input",
        $"admiral-number-input--{(Size == AdmiralInputSize.Small ? "s" : Size == AdmiralInputSize.ExtraLarge ? "xl" : "m")}",
        Status == AdmiralInputStatus.Default ? null : $"admiral-number-input--{StatusName}",
        DisplayPlusMinusIcons ? "admiral-number-input--with-steppers" : null,
        ShowClearAction ? "admiral-number-input--with-clear" : null,
        Skeleton ? "rz-skeleton admiral-number-input--skeleton" : null,
        Class
    }.Where(value => !string.IsNullOrWhiteSpace(value)));
}
