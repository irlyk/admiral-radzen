<AdmiralMenu AriaLabel="@AriaLabel" Class="@MenuClass">
    <Trigger>
        <AdmiralTag Text="@Text" Kind="@Kind" Size="@Size" StatusViaBackground="@StatusViaBackground"
                    Disabled="@Disabled" Click="HandleTriggerClick" />
    </Trigger>
    <ChildContent>@ChildContent</ChildContent>
</AdmiralMenu>

@code {
    [Parameter] public string Text { get; set; } = "Tag menu";
    [Parameter] public AdmiralTagKind Kind { get; set; }
    [Parameter] public AdmiralTagSize Size { get; set; }
    [Parameter] public bool StatusViaBackground { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "Tag menu";
    [Parameter] public string? MenuClass { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private static Task HandleTriggerClick(MouseEventArgs _) => Task.CompletedTask;
}
