<RadzenButton class="@CssClass"
              Size="@RadzenSize"
              Variant="@RadzenVariant"
              ButtonStyle="@RadzenButtonStyle"
              ButtonType="@EffectiveButtonType"
              Disabled="@(Disabled || Skeleton)"
              Click="@HandleClick"
              aria-label="@SquareAccessibleName"
              aria-busy="@(Loading ? "true" : null)"
              aria-disabled="@(IsInteractionBlocked ? "true" : null)"
              @attributes="AdditionalAttributes">
    @if (Loading)
    {
        <span class="admiral-button__spinner">
            <AdmiralSpinner Size="@SpinnerSize" Inverse="@SpinnerInverse" AriaLabel="Loading" />
        </span>
    }
    <span class="admiral-button__content">
        @if (IconStartContent is not null)
        {
            <span class="admiral-button__icon">@IconStartContent</span>
        }
        else if (!string.IsNullOrWhiteSpace(IconStart))
        {
            <AdmiralIcon Icon="@IconStart" Size="@ContentIconSize" aria-hidden="true" />
        }

        @if (!DisplayAsSquare)
        {
            <span class="admiral-button__text">
                @if (ChildContent is not null)
                {
                    @ChildContent
                }
                else
                {
                    @Text
                }
            </span>
        }

        @if (ShowBadge)
        {
            <AdmiralBadge Text="@BadgeCount!.Value.ToString()"
                          Dimension="AdmiralBadgeDimension.S"
                          Appearance="@ButtonBadgeAppearance"
                          Class="admiral-button__badge" />
        }

        @if (IconEndContent is not null)
        {
            <span class="admiral-button__icon">@IconEndContent</span>
        }
        else if (!string.IsNullOrWhiteSpace(IconEnd))
        {
            <AdmiralIcon Icon="@IconEnd" Size="@ContentIconSize" aria-hidden="true" />
        }
    </span>
</RadzenButton>

@code {
    [CascadingParameter] private AdmiralButtonGroup? Group { get; set; }
    [Parameter] public string? Text { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? IconStart { get; set; }
    [Parameter] public string? IconEnd { get; set; }
    [Parameter] public RenderFragment? IconStartContent { get; set; }
    [Parameter] public RenderFragment? IconEndContent { get; set; }
    [Parameter] public AdmiralButtonAppearance Appearance { get; set; }
    [Parameter] public AdmiralButtonDimension Dimension { get; set; } = AdmiralButtonDimension.Xl;
    [Parameter] public AdmiralButtonType Type { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool DisplayAsDisabled { get; set; }
    [Parameter] public bool DisplayAsSquare { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Skeleton { get; set; }
    [Parameter] public int? BadgeCount { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> Click { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private AdmiralButtonDimension EffectiveDimension => Group?.Dimension ?? Dimension;
    private AdmiralButtonAppearance EffectiveAppearance => Group?.ButtonAppearance ?? Appearance;

    private ButtonSize RadzenSize => EffectiveDimension switch
    {
        AdmiralButtonDimension.S => ButtonSize.ExtraSmall,
        AdmiralButtonDimension.M => ButtonSize.Small,
        AdmiralButtonDimension.L => ButtonSize.Medium,
        _ => ButtonSize.Large
    };

    private Variant RadzenVariant => EffectiveAppearance switch
    {
        AdmiralButtonAppearance.Secondary or AdmiralButtonAppearance.White => Variant.Outlined,
        AdmiralButtonAppearance.Tertiary => Variant.Flat,
        AdmiralButtonAppearance.Ghost => Variant.Text,
        _ => Variant.Filled
    };

    private ButtonStyle RadzenButtonStyle => EffectiveAppearance switch
    {
        AdmiralButtonAppearance.Danger => ButtonStyle.Danger,
        AdmiralButtonAppearance.Success => ButtonStyle.Success,
        _ => ButtonStyle.Primary
    };

    private ButtonType RadzenButtonType => Type switch
    {
        AdmiralButtonType.Submit => ButtonType.Submit,
        AdmiralButtonType.Reset => ButtonType.Reset,
        _ => ButtonType.Button
    };

    // Keep the loading appearance while preventing native submit/reset actions.
    private ButtonType EffectiveButtonType => Loading ? ButtonType.Button : RadzenButtonType;

    private AdmiralIconSize ContentIconSize => EffectiveDimension == AdmiralButtonDimension.S
        ? AdmiralIconSize.Medium
        : AdmiralIconSize.Large;

    private AdmiralSpinnerSize SpinnerSize => EffectiveDimension == AdmiralButtonDimension.S
        ? AdmiralSpinnerSize.MediumSmall
        : AdmiralSpinnerSize.Medium;

    private bool SpinnerInverse => EffectiveAppearance is AdmiralButtonAppearance.Primary
        or AdmiralButtonAppearance.White
        or AdmiralButtonAppearance.Danger
        or AdmiralButtonAppearance.Success;

    private bool ShowBadge => BadgeCount.HasValue && !DisplayAsSquare && EffectiveAppearance is
        AdmiralButtonAppearance.Primary or AdmiralButtonAppearance.Secondary or
        AdmiralButtonAppearance.Tertiary or AdmiralButtonAppearance.Ghost;

    private AdmiralBadgeAppearance ButtonBadgeAppearance => (Disabled || DisplayAsDisabled, EffectiveAppearance) switch
    {
        (true, AdmiralButtonAppearance.Primary or AdmiralButtonAppearance.Tertiary) => AdmiralBadgeAppearance.WhiteDisabled,
        (true, _) => AdmiralBadgeAppearance.LightDisabled,
        (false, AdmiralButtonAppearance.Primary) => AdmiralBadgeAppearance.WhiteBlue,
        (false, AdmiralButtonAppearance.Tertiary) => AdmiralBadgeAppearance.White,
        _ => AdmiralBadgeAppearance.Info
    };

    private bool IsInteractionBlocked => Disabled || Loading || Skeleton;

    private string? SquareAccessibleName => DisplayAsSquare && !string.IsNullOrWhiteSpace(Text)
        ? Text
        : null;

    private Task HandleClick(MouseEventArgs args) => IsInteractionBlocked
        ? Task.CompletedTask
        : Click.InvokeAsync(args);

    private string CssClass => string.Join(' ', new[]
    {
        "admiral-button",
        $"admiral-button--{EffectiveAppearance.ToString().ToLowerInvariant()}",
        DisplayAsSquare ? "rz-button-icon-only admiral-button--square" : null,
        DisplayAsDisabled ? "rz-state-disabled admiral-button--display-disabled" : null,
        Loading ? "admiral-button--loading" : null,
        Skeleton ? "rz-skeleton admiral-button--skeleton" : null,
        Class
    }.Where(value => !string.IsNullOrWhiteSpace(value)));
}
