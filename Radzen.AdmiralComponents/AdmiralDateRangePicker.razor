<div class="@CssClass" @attributes="AdditionalAttributes">
    <RadzenDatePicker TValue="IEnumerable<DateTime>"
                      Value="@selectedDates"
                      ValueChanged="HandleDatesChanged"
                      Multiple="true"
                      Disabled="@Disabled"
                      DateFormat="@DateFormat"
                      Placeholder=" "
                      ShowButtonBar="@ShowButtonBar"
                      Min="@Min"
                      Max="@Max"
                      Culture="@Culture"
                      DateRender="RenderDate"
                      ToggleAriaLabel="@ToggleAriaLabel"
                      PopupAriaLabel="@PopupAriaLabel"
                      InputAttributes="@InputAttributes" />
    <input class="admiral-date-range-picker__input"
           value="@inputValue"
           placeholder="@Placeholder"
           aria-label="@AriaLabel"
           aria-invalid="@inputInvalid.ToString().ToLowerInvariant()"
           autocomplete="off"
           inputmode="@(AllowInput ? "text" : "none")"
           disabled="@Disabled"
           readonly="@(!AllowInput)"
           @oninput="HandleInput"
           @onblur="CommitInputAsync"
           @onkeydown="HandleKeyDownAsync" />
</div>
