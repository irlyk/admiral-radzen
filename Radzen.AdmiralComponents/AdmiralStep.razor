@if (IsClickable && !string.IsNullOrWhiteSpace(Link))
{
    <a class="@CssClass" href="@Link" role="listitem" aria-current="@AriaCurrent" @onclick="HandleClick" @attributes="AdditionalAttributes">@StepBody</a>
}
else if (IsClickable)
{
    <button type="button" class="@CssClass" role="listitem" aria-current="@AriaCurrent" @onclick="HandleClick" @attributes="AdditionalAttributes">@StepBody</button>
}
else
{
    <li class="@CssClass" aria-current="@AriaCurrent" @attributes="AdditionalAttributes">@StepBody</li>
}

@code {
    private int index;

    [CascadingParameter] private AdmiralStepper? Stepper { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool? Active { get; set; }
    [Parameter] public bool? Completed { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Error { get; set; }
    [Parameter] public bool Warning { get; set; }
    [Parameter] public bool Redo { get; set; }
    [Parameter] public string? Link { get; set; }
    [Parameter] public EventCallback<AdmiralStepClickEventArgs> Click { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    protected override void OnInitialized() => index = Stepper?.ClaimIndex() ?? 0;

    private bool IsActive => Active ?? Stepper?.CurrentActiveStep == index;
    private bool IsCompleted => (Completed ?? (Stepper is not null && index < Stepper.CurrentActiveStep)) && !Disabled;
    private bool IsDisabled => Disabled || (!IsCompleted && !IsActive);
    private bool IsClickable => !IsDisabled && IsCompleted && (Click.HasDelegate || !string.IsNullOrWhiteSpace(Link));
    private string? AriaCurrent => IsActive ? "step" : null;

    private RenderFragment StepBody => builder =>
    {
        builder.OpenElement(0, "span"); builder.AddAttribute(1, "class", "admiral-step__content");
        builder.OpenElement(2, "span"); builder.AddAttribute(3, "class", "admiral-step__track");
        builder.OpenElement(4, "span"); builder.AddAttribute(5, "class", "admiral-step__icon");
        builder.AddContent(6, Error || Warning ? "!" : IsCompleted ? "✓" : string.Empty);
        builder.CloseElement();
        builder.OpenElement(7, "span"); builder.AddAttribute(8, "class", "admiral-step__rail"); builder.CloseElement();
        builder.CloseElement();
        builder.OpenElement(9, "span"); builder.AddAttribute(10, "class", "admiral-step__label"); builder.AddContent(11, ChildContent); builder.CloseElement();
        builder.CloseElement();
    };

    private async Task HandleClick()
    {
        if (!IsClickable) return;
        await Stepper!.SelectAsync(index);
        await Click.InvokeAsync(new(index, IsActive, IsCompleted, IsDisabled));
    }

    private string CssClass => string.Join(' ', new[]
    {
        "admiral-step", IsActive ? "admiral-step--active" : null, IsCompleted ? "admiral-step--completed" : null,
        IsDisabled ? "admiral-step--disabled" : null, Error ? "admiral-step--error" : null,
        Warning ? "admiral-step--warning" : null, Redo ? "admiral-step--redo" : null,
        IsClickable ? "admiral-step--clickable" : null, Class
    }.Where(value => !string.IsNullOrWhiteSpace(value)));
}
