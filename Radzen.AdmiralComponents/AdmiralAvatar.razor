<button type="button"
        class="@CssClass"
        style="@Style"
        disabled="@Disabled"
        title="@(ShowTooltip ? Name : null)"
        aria-label="@Name"
        @onclick="Click"
        @attributes="AdditionalAttributes">
    <span class="admiral-avatar__core">
        <span class="admiral-avatar__initials" aria-hidden="true">@ResolvedInitials</span>
        @if (!string.IsNullOrWhiteSpace(Icon) && string.IsNullOrWhiteSpace(ImageUrl))
        {
            <RadzenIcon Icon="@Icon" class="admiral-avatar__icon" aria-hidden="true" />
        }
        @if (!string.IsNullOrWhiteSpace(ImageUrl))
        {
            <img class="admiral-avatar__image" src="@ImageUrl" alt="" aria-hidden="true" />
        }
    </span>
    @if (Status != AdmiralAvatarStatus.None)
    {
        <span class="@StatusCssClass" aria-hidden="true"></span>
    }
</button>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter] public string? Initials { get; set; }
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public AdmiralAvatarSize Size { get; set; } = AdmiralAvatarSize.Xl;
    [Parameter] public AdmiralAvatarAppearance Appearance { get; set; } = AdmiralAvatarAppearance.Neutral2;
    [Parameter] public AdmiralAvatarStatus Status { get; set; }
    [Parameter] public bool WithActivityRing { get; set; }
    [Parameter] public bool ShowActivityRing { get; set; }
    [Parameter] public bool ShowTooltip { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> Click { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private AdmiralAvatarSize EffectiveSize =>
        Size == AdmiralAvatarSize.Xxs && (Status != AdmiralAvatarStatus.None || WithActivityRing)
            ? AdmiralAvatarSize.Xs
            : Size;

    private string ResolvedInitials
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(Initials))
            {
                return Initials;
            }

            var maximumLength = EffectiveSize is AdmiralAvatarSize.Xxs or AdmiralAvatarSize.Xs ? 1 : 2;
            var words = Name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            return string.Concat(words.Select(word => char.ToUpperInvariant(word[0]))).Substring(0, Math.Min(maximumLength, words.Length));
        }
    }

    private string SizeName => EffectiveSize switch
    {
        AdmiralAvatarSize.Xxs => "xxs",
        AdmiralAvatarSize.Xs => "xs",
        AdmiralAvatarSize.Small => "s",
        AdmiralAvatarSize.Medium => "m",
        AdmiralAvatarSize.Large => "l",
        _ => "xl"
    };

    private string AppearanceName => Appearance.ToString().ToLowerInvariant();
    private string StatusName => Status.ToString().ToLowerInvariant();
    private string StatusCssClass => $"admiral-avatar__status admiral-avatar__status--{StatusName}";
    private string CssClass => string.Join(' ', new[]
    {
        "admiral-avatar",
        $"admiral-avatar--{SizeName}",
        $"admiral-avatar--{AppearanceName}",
        WithActivityRing ? "admiral-avatar--activity" : null,
        WithActivityRing && ShowActivityRing ? "admiral-avatar--activity-visible" : null,
        Class
    }.Where(value => !string.IsNullOrWhiteSpace(value)));
}
