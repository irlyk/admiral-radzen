@page "/"

<PageTitle>AdmiralRadzen</PageTitle>
<section class="docs-landing">
    <h1>@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ru" ? "Документация компонентов" : "Component documentation")</h1>
    <p>@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ru" ? "Интерактивные примеры Admiral и прямого Radzen, Razor-код и справка API." : "Interactive Admiral and direct Radzen examples, Razor code, and API references.")</p>
    <div class="docs-catalog">
        @foreach (var group in DocsCatalog.Groups)
        {
            <section class="docs-card">
                <h2>@group.Label(IsRussian)</h2>
                <ul>
                    @foreach (var entry in group.Entries)
                    {
                        <li><a href="@entry.Href">@entry.Label(IsRussian)</a></li>
                    }
                </ul>
            </section>
        }
    </div>
</section>

@code {
    private static bool IsRussian => System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ru";
}
