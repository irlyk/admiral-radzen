<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AdmiralConsumerSmoke</RootNamespace>
    <AssemblyName>AdmiralDocs</AssemblyName>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.13" />
    <PackageReference Include="Radzen.Blazor" Version="12.0.6" />
    <PackageReference Include="AdmiralRadzen.Components" Version="2.0.0" />
    <PackageReference Include="AdmiralRadzen.Icons" Version="2.0.0" />
    <PackageReference Include="AdmiralRadzen.Themes" Version="2.0.0" />
  </ItemGroup>
  <!-- Share the browser-compatible documentation with the smoke app. -->
  <ItemGroup>
    <RazorComponent Include="../AdmiralConsumerSmoke/Pages/*.razor"
                    Exclude="../AdmiralConsumerSmoke/Pages/Index.razor;../AdmiralConsumerSmoke/Pages/Coverage.razor;../AdmiralConsumerSmoke/Pages/Inputs.razor;../AdmiralConsumerSmoke/Pages/RegressionOverview.razor;../AdmiralConsumerSmoke/Pages/FileInput.razor"
                    Link="Pages/%(Filename)%(Extension)" />
    <Compile Include="../AdmiralConsumerSmoke/Pages/*.razor.cs" Link="Pages/%(Filename)%(Extension)" />
    <None Include="../AdmiralConsumerSmoke/Pages/*.razor.css"
          Exclude="../AdmiralConsumerSmoke/Pages/FileInput.razor.css"
          Link="Pages/%(Filename)%(Extension)" />
    <RazorComponent Include="../AdmiralConsumerSmoke/Shared/*.razor" Link="Shared/%(Filename)%(Extension)" />
    <Compile Include="../AdmiralConsumerSmoke/Shared/ComponentDocsCatalog.cs" Link="Shared/ComponentDocsCatalog.cs" />
    <Compile Include="../AdmiralConsumerSmoke/SharedResource.cs" Link="SharedResource.cs" />
    <EmbeddedResource Include="../AdmiralConsumerSmoke/Resources/SharedResource.ru.resx" Link="Resources/SharedResource.ru.resx" />
    <EmbeddedResource Include="../AdmiralConsumerSmoke/Resources/SharedResource.en.resx" Link="Resources/SharedResource.en.resx" />
    <Content Remove="wwwroot/css/site.css" />
    <Content Include="../AdmiralConsumerSmoke/wwwroot/css/site.css" Link="wwwroot/css/site.css" />
    <Content Include="../AdmiralConsumerSmoke/wwwroot/images/*.svg" Link="wwwroot/images/%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="PreparePagesFallback" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)wwwroot/index.html" DestinationFiles="$(PublishDir)wwwroot/404.html" Condition="Exists('$(PublishDir)wwwroot/index.html')" />
  </Target>
</Project>
