<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RadzenBlazorVersion Condition="'$(RadzenBlazorVersion)' == ''">12.0.6</RadzenBlazorVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Radzen.Blazor" Version="$(RadzenBlazorVersion)" />
    <PackageReference Include="AdmiralRadzen.Components" Version="2.0.0" />
    <PackageReference Include="AdmiralRadzen.Icons" Version="2.0.0" />
    <PackageReference Include="AdmiralRadzen.Themes" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../docs/admiral-component-coverage.md"
                      LogicalName="AdmiralComponentCoverage.md" />
  </ItemGroup>

</Project>
