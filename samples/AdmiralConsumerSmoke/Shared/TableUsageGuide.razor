        new("FormatString / TextAlign", "string / TextAlign", "Формат значения и выравнивание. Например {0:N2} и Right для суммы."),
        new("Template / EditTemplate", "RenderFragment<TItem>", "Отображение и редактор ячейки с контекстом текущей строки."),
