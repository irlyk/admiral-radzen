@page "/"

<PageTitle>@T("Документация AdmiralRadzen", "AdmiralRadzen documentation")</PageTitle>

<main class="docs-home">
    <header class="docs-home__hero">
        <span class="docs-home__eyebrow">AdmiralRadzen</span>
        <h1>@T("Документация компонентов", "Component documentation")</h1>
        <p>@T("Интерактивные примеры компонентов Admiral и прямого использования Radzen с темой Admiral. Найдите компонент через меню или выберите раздел ниже.", "Interactive examples of Admiral components and direct Radzen usage with the Admiral theme. Search the menu or choose a category below.")</p>
        <div class="docs-home__hero-links">
            <a href="/components/button">@T("Начать с Button", "Start with Button")</a>
            <a href="/tables">@T("Изучить Table", "Explore Table")</a>
            <a href="/coverage">@T("Посмотреть покрытие", "View coverage")</a>
        </div>
    </header>

    <section class="docs-home__intro" aria-labelledby="docs-home-how-to-heading">
        <h2 id="docs-home-how-to-heading">@T("Как пользоваться документацией", "How to use these docs")</h2>
        <div class="docs-home__intro-grid">
            <p>@T("На странице каждого компонента вкладка Admiral показывает управляемый пример; вкладка Radzen + theme — прямой Radzen API; Usage and API содержит разметку и справочник параметров.", "Each component page has an Admiral playground, a direct Radzen + theme example, and a Usage and API reference with markup and parameters.")</p>
            <p>@T("Переключайте светлую и тёмную темы в верхней панели. Старые интеграционные примеры сохранены в регрессионной галерее.", "Switch light and dark themes in the header. Existing integration examples remain in the regression gallery.")</p>
        </div>
        <a href="/regression/overview">@T("Открыть регрессионную галерею", "Open regression gallery")</a>
    </section>

    <nav class="docs-home__directory" aria-label="@T("Разделы компонентов", "Component categories")">
        <section class="docs-home__category" aria-labelledby="docs-home-actions">
            <h2 id="docs-home-actions">@T("Действия", "Actions")</h2>
            <p>@T("Кнопки, группы и панели действий.", "Buttons, groups, and action surfaces.")</p>
            <div class="docs-home__links">
                <a href="/components/button">Button</a><a href="/components/icon-button">IconButton</a><a href="/components/text-button">TextButton</a>
                <a href="/components/button-groups">Button groups</a><a href="/components/floating-button-menu">FloatingButtonMenu</a><a href="/components/action-bar">ActionBar</a>
            </div>
        </section>
        <section class="docs-home__category" aria-labelledby="docs-home-inputs">
            <h2 id="docs-home-inputs">@T("Поля ввода", "Inputs")</h2>
            <p>@T("Поля, выбор значений, флажки и загрузка файлов.", "Fields, selection controls, checkboxes, and uploads.")</p>
            <div class="docs-home__links">
                <a href="/components/checkbox">Checkbox</a><a href="/components/checkbox-group">Checkbox groups</a>
                <a href="/components/text-input">TextInput</a><a href="/components/text-area">TextArea</a><a href="/components/number-input">NumberInput</a>
                <a href="/components/select">Select</a><a href="/components/input-field">InputField</a><a href="/components/drop-down">DropDown</a>
                <a href="/components/date-range-picker">DateRangePicker</a><a href="/components/tree-select">TreeSelect</a><a href="/components/slider">Slider / Range</a>
                <a href="/components/phone-number-input">PhoneNumberInput</a><a href="/components/file-input">FileInput</a>
                <a href="/components/global-search">GlobalSearch</a>
            </div>
        </section>
        <section class="docs-home__category" aria-labelledby="docs-home-navigation">
            <h2 id="docs-home-navigation">@T("Навигация", "Navigation")</h2>
            <p>@T("Переходы, меню, панели и пошаговые сценарии.", "Links, menus, panels, and step flows.")</p>
            <div class="docs-home__links">
                <a href="/components/link">Link</a><a href="/components/menu">Menu</a><a href="/components/drawer">Drawer</a>
                <a href="/components/stepper">Stepper</a><a href="/components/tree">Tree</a><a href="/components/pagination">Pagination</a>
            </div>
        </section>
        <section class="docs-home__category" aria-labelledby="docs-home-display">
            <h2 id="docs-home-display">@T("Отображение данных", "Data Display")</h2>
            <p>@T("Текст, метки, списки, изображения и таблицы.", "Text, labels, lists, images, and tables.")</p>
            <div class="docs-home__links">
                <a href="/components/typography">Typography</a><a href="/components/divider">Divider</a><a href="/components/badge">Badge</a>
                <a href="/components/chips">Chips</a><a href="/components/pills">Pills</a><a href="/components/tag">Tag</a>
                <a href="/components/lists">Lists</a><a href="/components/scroll-container">ScrollContainer</a>
                <a href="/components/carousel">Carousel</a><a href="/components/image-viewer">ImageViewer</a><a href="/tables">Table</a>
                <a href="/components/avatar">Avatar</a><a href="/components/status-indicator">StatusIndicator</a><a href="/components/grid">Grid</a>
            </div>
        </section>
        <section class="docs-home__category" aria-labelledby="docs-home-feedback">
            <h2 id="docs-home-feedback">@T("Обратная связь", "Feedback")</h2>
            <p>@T("Загрузка, подсказки и уведомления.", "Loading, hints, and notifications.")</p>
            <div class="docs-home__links">
                <a href="/components/skeleton">Skeleton</a><a href="/components/tooltip">Tooltip</a>
                <a href="/components/hint">Hint</a><a href="/components/toast">Toast</a>
                <a href="/components/progress">Progress</a><a href="/components/spinner">Spinner</a>
            </div>
        </section>
    </nav>

    <section class="docs-home__resources" aria-labelledby="docs-home-resources">
        <h2 id="docs-home-resources">@T("Справочные разделы", "Reference pages")</h2>
        <div class="docs-home__resource-links">
            <a href="/icons">@T("Иконки", "Icons")</a>
            <a href="/coverage">@T("Покрытие компонентов", "Component coverage")</a>
            <a href="/guide/integration">@T("Подключение пакетов", "Package integration")</a>
            <a href="/regression/inputs">@T("Регрессионные примеры полей", "Input regression examples")</a>
            <a href="/regression/layout">@T("Регрессионные примеры сетки", "Grid regression examples")</a>
        </div>
    </section>
</main>

@code {
    private static bool IsRussian => System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ru";
    private static string T(string russian, string english) => IsRussian ? russian : english;
}
