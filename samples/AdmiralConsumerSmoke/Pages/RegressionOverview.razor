                                <p class="admiral-carousel-slide__eyebrow">@L["Documents"]</p>
                                <h3 class="admiral-carousel-slide__title">@L["Statements are ready"]</h3>
                                <p class="admiral-carousel-slide__body">@L["Download the latest account documents and reports."]</p>
                            </article>
                        </RadzenCarouselItem>
                    </Items>
                </RadzenCarousel>
            </div>
            <div>
                <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0 rz-mb-2">@L["Outer slider"]</RadzenText>
                <RadzenCarousel @bind-SelectedIndex="outerCarouselIndex" Auto="false" AllowScroll="true"
                                AllowNavigation="true" AllowPaging="true" PagerOverlay="false"
                                PagerPosition="PagerPosition.Bottom" AnimationDuration="300"
                                class="admiral-carousel admiral-carousel--outer" Style="height: 16rem;">
                    <Items>
                        <RadzenCarouselItem>
                            <article class="admiral-carousel-slide">
                                <p class="admiral-carousel-slide__eyebrow">@L["Account"]</p>
                                <h3 class="admiral-carousel-slide__title">@L["Operating balance"]</h3>
                                <p class="admiral-carousel-slide__body">@L["2 480 600 ₽ available for payments today."]</p>
                            </article>
                        </RadzenCarouselItem>
                        <RadzenCarouselItem>
                            <article class="admiral-carousel-slide">
                                <p class="admiral-carousel-slide__eyebrow">@L["Schedule"]</p>
                                <h3 class="admiral-carousel-slide__title">@L["Three payments pending"]</h3>
                                <p class="admiral-carousel-slide__body">@L["The next payment is scheduled for 14:30."]</p>
                            </article>
                        </RadzenCarouselItem>
                        <RadzenCarouselItem>
                            <article class="admiral-carousel-slide">
                                <p class="admiral-carousel-slide__eyebrow">@L["Team"]</p>
                                <h3 class="admiral-carousel-slide__title">@L["Approvals configured"]</h3>
                                <p class="admiral-carousel-slide__body">@L["Two operators can approve outgoing payments."]</p>
