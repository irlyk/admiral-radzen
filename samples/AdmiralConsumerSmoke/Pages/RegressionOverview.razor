                        <RadzenCarouselItem>
                            <article class="admiral-carousel-slide admiral-carousel-slide--accent">
                                <p class="admiral-carousel-slide__eyebrow">@L["Analytics"]</p>
                                <h3 class="admiral-carousel-slide__title">@L["Cash flow overview"]</h3>
