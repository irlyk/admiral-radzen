    private static void RenderPaymentRow(RowRenderEventArgs<PaymentRow> args)
    {
        if (args.Data is null)
        {
            return;
        }

        args.Expandable = true;
        args.Attributes["class"] = args.Data.Status switch
        {
            "Completed" => "admiral-table-row--success",
            "Pending" => "admiral-table-row--warning",
            _ => "admiral-table-row--danger"
        };
    }

