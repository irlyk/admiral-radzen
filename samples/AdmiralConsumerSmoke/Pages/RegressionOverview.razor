    private string LiveUploadUrl => simulateUploadError ? "/upload/smoke/error" : "/upload/smoke/success";
    private string LiveUploadIcon => Path.GetExtension(liveUploadName).Equals(".pdf", StringComparison.OrdinalIgnoreCase)
        ? "admiral:documents/file-pdf-outline"
        : "admiral:documents/file-outline";
    private string LiveUploadMeta
    {
        get
        {
            var extension = Path.GetExtension(liveUploadName).TrimStart('.').ToUpperInvariant();
            var size = liveUploadSize < 1024 * 1024
                ? $"{Math.Max(1, Math.Ceiling(liveUploadSize / 1024d)):0} KB"
                : $"{liveUploadSize / 1024d / 1024d:0.#} MB";
            var status = liveUploadState switch
            {
                AdmiralUploadState.Loading => L["Loading"].Value,
                AdmiralUploadState.Complete => L["Uploaded"].Value,
                AdmiralUploadState.Error => L["Upload failed"].Value,
                _ => L["Ready to upload"].Value
            };
            return $"{extension} · {size} · {status}";
        }
    }

    private void HandleUploadChange(UploadChangeEventArgs args)
    {
        var file = args.Files?.FirstOrDefault();
        liveUploadHasFile = file is not null;
        liveUploadName = file?.Name ?? string.Empty;
        liveUploadSize = file?.Size ?? 0;
        liveUploadState = AdmiralUploadState.Idle;
        liveUploadProgress = 0;
        liveUploadError = null;
    }

    private void HandleUploadProgress(UploadProgressArgs args)
    {
        liveUploadState = AdmiralUploadState.Loading;
        liveUploadProgress = args.Progress;
    }

    private void HandleUploadComplete(UploadCompleteEventArgs args)
    {
        liveUploadState = args.Cancelled ? AdmiralUploadState.Idle : AdmiralUploadState.Complete;
        liveUploadProgress = args.Cancelled ? 0 : 100;
        liveUploadError = null;
    }

    private void HandleUploadError(UploadErrorEventArgs args)
    {
        liveUploadState = AdmiralUploadState.Error;
        liveUploadError = L["The server rejected the test upload"].Value;
    }

    private async Task SendLiveUpload()
    {
        if (liveUpload is null || !liveUploadHasFile)
        {
            return;
        }

        liveUploadState = AdmiralUploadState.Loading;
        liveUploadProgress = 0;
        liveUploadError = null;
        await liveUpload.Upload();
    }

    private async Task ResetLiveUpload()
    {
        if (liveUpload is not null)
        {
            await liveUpload.ClearFiles();
        }

        liveUploadHasFile = false;
        liveUploadName = string.Empty;
        liveUploadSize = 0;
        liveUploadState = AdmiralUploadState.Idle;
        liveUploadProgress = 0;
        liveUploadError = null;
    }

