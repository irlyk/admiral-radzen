    private async Task<AdmiralDropDownResult<BeneficiaryOption>> LoadBeneficiariesAsync(
        AdmiralDropDownQuery query, CancellationToken cancellationToken)
    {
        await Task.Delay(450, cancellationToken);
        if (query.SearchText.Equals("error", StringComparison.OrdinalIgnoreCase))
        {
            throw new InvalidOperationException("Smoke provider failure");
        }

        var filtered = string.IsNullOrWhiteSpace(query.SearchText)
            ? beneficiaryOptions.AsEnumerable()
            : beneficiaryOptions.Where(option => option.Name.Contains(query.SearchText, StringComparison.OrdinalIgnoreCase));
        var matches = filtered.ToArray();
        var page = matches.Skip(query.Skip).Take(query.Take ?? matches.Length).ToArray();
        return new(page, matches.Length);
    }

