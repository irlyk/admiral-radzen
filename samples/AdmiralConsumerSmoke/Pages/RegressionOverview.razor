    </section>

    <section class="admiral-gallery__section" aria-labelledby="upload-heading">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H2" id="upload-heading">@L["File uploader"]</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2">
            @L["Admiral XL and M file inputs with drag-and-drop, keyboard focus, selected files and representative upload states."]
        </RadzenText>
        <div class="admiral-gallery__form-grid">
            <div>
                <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0 rz-mb-2">@L["XL · live upload"]</RadzenText>
                <RadzenUpload @ref="liveUpload"
                              class="admiral-file-input admiral-file-input--xl admiral-file-input--external-status"
                              Url="@LiveUploadUrl"
                              Multiple="false" Auto="false" MaxFileCount="1"
                              Accept=".pdf,.doc,.docx,.png,.jpg"
                              Icon="admiral:system/attach-file-outline"
                              ChooseText="@L["Drop a file here or click to select"]" DeleteText="@L["Remove file"]"
                              Change="HandleUploadChange" Progress="HandleUploadProgress"
                              Complete="HandleUploadComplete" Error="HandleUploadError" />
                <div class="admiral-file-input__hint">@L["PDF, DOCX, PNG or JPG · up to 10 MB"]</div>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Wrap="FlexWrap.Wrap"
                             class="admiral-file-input__actions">
                    <RadzenButton Text="@L["Send file"]" Icon="admiral:system/upload-outline"
                                  Size="ButtonSize.Small" Disabled="@(!liveUploadHasFile || liveUploadState == AdmiralUploadState.Loading)"
                                  Click="SendLiveUpload" />
                    <RadzenButton Text="@L["Reset"]" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base"
                                  Size="ButtonSize.Small" Disabled="@(!liveUploadHasFile)" Click="ResetLiveUpload" />
                    <RadzenSwitch @bind-Value="simulateUploadError" Disabled="@liveUploadHasFile" />
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">@L["Simulate server error"]</RadzenText>
                </RadzenStack>
                @if (liveUploadHasFile)
                {
                    <AdmiralUploadStatus FileName="@liveUploadName"
                                         Meta="@LiveUploadMeta"
                                         Icon="@LiveUploadIcon"
                                         State="@liveUploadState"
                                         Progress="@liveUploadProgress"
                                         ErrorText="@liveUploadError"
                                         ActionAriaLabel="@L["Remove file"]"
                                         ActionClicked="ResetLiveUpload" />
                }
            </div>
            <div>
                <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0 rz-mb-2">@L["M · disabled"]</RadzenText>
                <RadzenUpload class="admiral-file-input admiral-file-input--m"
                              Disabled="true" Auto="false"
                              Icon="admiral:system/attach-file-outline"
                              ChooseText="@L["File selection is unavailable"]" />
                <div class="admiral-file-input__hint">@L["The disabled state keeps the same compact geometry."]</div>
            </div>
        </div>
        <div class="admiral-upload-files" aria-label="@L["File upload state examples"]">
            <AdmiralUploadStatus FileName="signed-payment.pdf"
                                 Meta="@L["PDF · 842 KB · Uploaded"]"
                                 Icon="admiral:documents/file-pdf-outline"
                                 State="AdmiralUploadState.Complete"
                                 ActionAriaLabel="@L["Remove uploaded file"]" />
            <AdmiralUploadStatus FileName="payment-register.pdf"
                                 Meta="@L["PDF · 2.4 MB · Loading"]"
                                 Icon="admiral:documents/file-pdf-outline"
                                 State="AdmiralUploadState.Loading"
                                 Progress="64"
                                 ActionAriaLabel="@L["Cancel upload"]" />
            <AdmiralUploadStatus FileName="transactions.xlsx"
                                 Meta="XLSX · 14.8 MB"
                                 ErrorText="@L["The file exceeds the 10 MB limit"]"
                                 Icon="admiral:documents/file-xlsx-outline"
                                 State="AdmiralUploadState.Error"
                                 ActionAriaLabel="@L["Remove failed file"]" />
        </div>
    </section>

    <section class="admiral-gallery__section" aria-labelledby="global-search-heading">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H2" id="global-search-heading">@L["Global search"]</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2">
            @L["Admiral search composition with prefix, clear and submit actions, suggestions and keyboard navigation."]
        </RadzenText>
        <AdmiralGlobalSearch Items="@GlobalSearchItems"
                             @bind-Value="globalSearchQuery"
                             Prefix="@L["Payments"]"
                             Placeholder="@L["Reference, company or account"]"
                             AriaLabel="@L["Global search"]"
                             ClearAriaLabel="@L["Clear search"]"
                             SubmitAriaLabel="@L["Search"]"
                             EmptyText="@L["No matches"]"
                             SearchSubmitted="@(value => globalSearchAction = $"Search: {value}")"
                             ItemSelected="@(item => globalSearchAction = $"Selected: {item.Id}")" />
        <p class="admiral-component-page__result" data-global-search-result aria-live="polite">@globalSearchAction</p>
        <p>@SmokeL["↑/↓ — выбор подсказки; Enter — выбор активной подсказки или отправка введённого запроса, если подсказка не выбрана. Escape закрывает список. Tab проходит к очистке и кнопке поиска, затем выходит из компонента."]

            <code>ItemSelected</code> @SmokeL["и"] <code>SearchSubmitted</code> @SmokeL["— отдельные события; выбор подсказки не вызывает оба сразу."]</p>
    </section>

    <section class="admiral-gallery__section" aria-labelledby="action-bar-heading">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H2" id="action-bar-heading">@L["Action bar and group actions"]</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2">
            @L["Admiral icon action groups, logical dividers, overflow menu and a table action pane with expandable search."]
        </RadzenText>
        <div class="admiral-gallery__form-grid">
            <div>
                <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0 rz-mb-2">ActionBar XL · 56 px</RadzenText>
                <AdmiralActionBar Items="@DocumentActions"
                                  OverflowItems="@DocumentOverflowActions"
                                  AriaLabel="@L["Document actions"]"
                                  OverflowAriaLabel="@L["More actions"]" />
            </div>
            <div>
                <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0 rz-mb-2">ActionBar M · 40 px</RadzenText>
                <AdmiralActionBar Items="@CompactActions"
                                  Size="AdmiralActionBarSize.Medium"
                                  AriaLabel="@L["Compact actions"]" />
            </div>
        </div>

        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0 rz-mt-4 rz-mb-2">GroupActionsPane XL</RadzenText>
        <AdmiralGroupActionsPane Actions="@GroupActions"
                                 @bind-SearchValue="paneSearchValue"
                                 @bind-Columns="paneColumns"
                                 SearchPlaceholder="@L["Search table"]"
                                 SearchAriaLabel="@L["Search table"]"
                                 OpenSearchAriaLabel="@L["Open search"]"
                                 CloseSearchAriaLabel="@L["Close search"]"
                                 ConfigureColumnsAriaLabel="@L["Configure columns"]"
                                 VisibleColumnsAriaLabel="@L["Visible columns"]"
                                 SettingsAriaLabel="@L["Table settings"]" />
    </section>

    <section class="admiral-gallery__section" aria-labelledby="progress-stepper-heading">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H2" id="progress-stepper-heading">@L["Progress stepper and page progress"]</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2">
            @L["Radzen step navigation plus Admiral desktop/mobile progress summaries and primary/error page progress."]
        </RadzenText>

        <RadzenSteps @bind-SelectedIndex="progressStepIndex" ShowStepsButtons="false" AllowStepSelect="true"
                     class="admiral-steps-demo">
            <Steps>
                <RadzenStepsItem Text="@L["Details"]"><RadzenText class="rz-m-0">@L["Enter payment details."]</RadzenText></RadzenStepsItem>
                <RadzenStepsItem Text="@L["Review"]"><RadzenText class="rz-m-0">@L["Review the payment before approval."]</RadzenText></RadzenStepsItem>
                <RadzenStepsItem Text="@L["Approval"]"><RadzenText class="rz-m-0">@L["Approve the payment."]</RadzenText></RadzenStepsItem>
                <RadzenStepsItem Text="@L["Complete"]"><RadzenText class="rz-m-0">@L["The payment is ready for processing."]</RadzenText></RadzenStepsItem>
            </Steps>
        </RadzenSteps>

        <div class="admiral-gallery__form-grid admiral-progress-stepper-grid">
            <AdmiralProgressStepper Steps="@ProgressStepNames"
                                    @bind-SelectedIndex="progressStepIndex"
                                    ShowActions="true"
                                    CounterFormat="@L["Step {0} of {1}"]"
                                    NextStepFormat="@L["Next: {0}"]"
                                    PreviousText="@L["Previous"]"
                                    NextText="@L["Next"]"
                                    AriaValueFormat="@L["Step {0}: {1}"]" />

            <AdmiralProgressStepper Steps="@ProgressStepNames"
                                    @bind-SelectedIndex="progressStepIndex"
                                    Mobile="true"
                                    CounterFormat="@L["Step {0} of {1}"]"
                                    NextStepFormat="@L["Next: {0}"]"
                                    AriaValueFormat="@L["Step {0}: {1}"]" />
        </div>

        <div class="admiral-gallery__form-grid admiral-progress-page-grid">
            <AdmiralProgressPage Label="@L["Uploading documents…"]" Value="64" />
            <AdmiralProgressPage Label="@L["Upload failed"]" Value="42"
                                 Status="AdmiralProgressPageStatus.Error" />
        </div>

        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mt-4 rz-mb-0">@L["Header progress"]</RadzenText>
        <div class="admiral-gallery__form-grid admiral-progress-header-grid">
            <div class="admiral-progress-header-demo">
                <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">@L["Primary"] — @progressHeaderValue%</RadzenText>
                <AdmiralProgressHeader Value="@progressHeaderValue" Inline="true"
                                       AriaLabel="@L["Primary header progress"]" />
                <RadzenButton Text="@L["Advance progress"]" Variant="Variant.Outlined"
                              Click="AdvanceHeaderProgress" />
            </div>
            <div class="admiral-progress-header-demo">
                <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">@L["Error"] — 42%</RadzenText>
                <AdmiralProgressHeader Value="42" Inline="true"
                                       Appearance="AdmiralProgressHeaderAppearance.Error"
                                       AriaLabel="@L["Error header progress"]" />
            </div>
        </div>
    </section>

    <section class="admiral-gallery__section" aria-labelledby="data-heading">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H2" id="data-heading">@L["Data table"]</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2">
            @L["The extended grid supports grouping, resizing, reordering, column picking, expandable rows and semantic row backgrounds."]
        </RadzenText>
        <AdmiralGroupActionsPane @bind-SearchValue="paymentGridSearchValue"
                                 @bind-Columns="paymentGridColumns"
                                 ShowSettings="false"
                                 SearchPlaceholder="@L["Search table"]"
                                 SearchAriaLabel="@L["Search table"]"
                                 OpenSearchAriaLabel="@L["Open search"]"
                                 CloseSearchAriaLabel="@L["Close search"]"
                                 ConfigureColumnsAriaLabel="@L["Configure columns"]"
                                 VisibleColumnsAriaLabel="@L["Visible columns"]"
                                 Class="admiral-data-grid__toolbar" />
        <RadzenDataGrid @ref="paymentsGrid" Data="FilteredPayments" TItem="PaymentRow"
                        AllowSorting="true" AllowMultiColumnSorting="true" ShowMultiColumnSortingIndex="true"
                        AllowFiltering="true" FilterMode="FilterMode.Advanced"
                        FilterText="@L["Filter"]" AndOperatorText="@L["And"]" OrOperatorText="@L["Or"]"
                        ApplyFilterText="@L["Apply"]" ClearFilterText="@L["Clear"]"
                        EqualsText="@L["Equals"]" NotEqualsText="@L["Not equals"]"
                        LessThanText="@L["Less than"]" LessThanOrEqualsText="@L["Less than or equals"]"
                        GreaterThanText="@L["Greater than"]" GreaterThanOrEqualsText="@L["Greater than or equals"]"
                        StartsWithText="@L["Starts with"]" EndsWithText="@L["Ends with"]"
                        ContainsText="@L["Contains"]" DoesNotContainText="@L["Does not contain"]"
                        InText="@L["In"]" NotInText="@L["Not in"]"
                        IsNullText="@L["Is null"]" IsNotNullText="@L["Is not null"]"
                        IsEmptyText="@L["Is empty"]" IsNotEmptyText="@L["Is not empty"]"
                        CustomText="@L["Custom"]"
                        AllowPaging="true" PageSize="6" AllowAlternatingRows="false"
                        GridLines="DataGridGridLines.Both"
                        PagerHorizontalAlign="HorizontalAlign.Center"
                        FirstPageTitle="@L["First page"]" FirstPageAriaLabel="@L["First page"]"
                        PrevPageTitle="@L["Previous page"]" PrevPageAriaLabel="@L["Previous page"]"
                        NextPageTitle="@L["Next page"]" NextPageAriaLabel="@L["Next page"]"
                        LastPageTitle="@L["Last page"]" LastPageAriaLabel="@L["Last page"]"
                        PageTitleFormat="@L["Page {0}"]" PageAriaLabelFormat="@L["Go to page {0}"]"
                        AllowColumnResize="true" AllowColumnReorder="true"
                        AllGroupsExpanded="true"
                        ExpandMode="DataGridExpandMode.Multiple" ShowExpandColumn="true" ShowExpandAll="false"
                        RowRender="RenderPaymentRow"
                        AllowRowSelectOnRowClick="true" SelectionMode="DataGridSelectionMode.Single"
                        @bind-Value="selectedPayments" Responsive="true"
                        class="admiral-data-grid admiral-table--m admiral-table--grey-header">
            <Template Context="payment">
                <div class="admiral-data-grid__detail">
                    <RadzenIcon Icon="admiral:system/info-outline" />
                    <div>
                        <strong>@L["Payment route"]</strong>
                        <span>@payment.Route · @L["Created by"]: @payment.CreatedBy</span>
                    </div>
                </div>
            </Template>
            <Columns>
                <RadzenDataGridColumn TItem="PaymentRow" Property="Reference" Title="@L["Reference"]" Width="10rem"
                                      Visible="@PaymentColumnVisible("reference")" />
                <RadzenDataGridColumn TItem="PaymentRow" Property="Beneficiary" Title="@L["Beneficiary"]" Width="15rem"
                                      Visible="@PaymentColumnVisible("beneficiary")" />
                <RadzenDataGridColumn TItem="PaymentRow" Property="Amount" Title="@L["Amount"]" Width="9rem"
                                      FormatString="{0:N2}" TextAlign="TextAlign.Right"
                                      Visible="@PaymentColumnVisible("amount")" />
                <RadzenDataGridColumn TItem="PaymentRow" Property="Currency" Title="@L["Currency"]" Width="7rem"
                                      Visible="@PaymentColumnVisible("currency")" />
                <RadzenDataGridColumn TItem="PaymentRow" Property="Status" Title="@L["Status"]" Width="9rem"
                                      Visible="@PaymentColumnVisible("status")">
                    <Template Context="payment">
                        <RadzenBadge Text="@L[payment.Status]" BadgeStyle="@GetStatusStyle(payment.Status)" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PaymentRow" Width="4rem" TextAlign="TextAlign.Center"
                                      Sortable="false" Filterable="false" Resizable="false" Reorderable="false">
                    <Template Context="payment">
                        <RadzenButton Icon="admiral:system/edit-outline"
                                      ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text"
                                      Size="ButtonSize.Small"
                                      aria-label="@($"{L["Edit"]}: {payment.Reference}")" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </section>
</div>

<AdmiralDrawer @bind-Open="drawerOpen"
               Title="@L["Payment details"]"
               CloseAriaLabel="@L["Close drawer"]">
    <ChildContent>
        <RadzenStack Gap="1rem">
            <RadzenText TextStyle="TextStyle.Body1" class="rz-m-0">
                @L["Review the payment information before sending it for processing."]
            </RadzenText>
            <RadzenFormField Text="@L["Reference"]">
                <RadzenTextBox Value="ADM-1042" ReadOnly="true" />
            </RadzenFormField>
            <RadzenFormField Text="@L["Beneficiary"]">
                <RadzenTextBox Value="Northern Star LLC" ReadOnly="true" />
            </RadzenFormField>
            <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Outlined">
                @L["The payment will be processed today."]
            </RadzenAlert>
        </RadzenStack>
    </ChildContent>
    <Actions>
        <RadzenButton Text="@L["Confirm"]" Click="@(_ => drawerOpen = false)" />
        <RadzenButton Text="@L["Cancel"]" ButtonStyle="ButtonStyle.Secondary"
                      Click="@(_ => drawerOpen = false)" />
    </Actions>
</AdmiralDrawer>

