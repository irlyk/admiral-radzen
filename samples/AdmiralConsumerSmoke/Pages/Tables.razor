    private async Task LoadAccordionTable(bool selected)
    {
        if (!selected || lazyRows is not null || lazyLoading)
        {
            return;
        }

        lazyLoading = true;
        await Task.Delay(650);
        lazyRows = payments.Take(3).ToArray();
        lazyLoading = false;
    }

    private async Task LoadServerRows(LoadDataArgs args)
    {
        serverLoading = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(120);
        serverRows = payments.Skip(args.Skip ?? 0).Take(args.Top ?? 4).ToArray();
        serverLoading = false;
    }

