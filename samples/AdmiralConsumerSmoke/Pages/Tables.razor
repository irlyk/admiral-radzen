    private bool IsColumnVisible(string id) => tableColumns.FirstOrDefault(column => column.Id == id)?.Visible ?? true;

    private static BadgeStyle StatusStyle(string status) => status switch
    {
        "Completed" => BadgeStyle.Success,
        "Pending" => BadgeStyle.Warning,
        _ => BadgeStyle.Danger
    };

    private void OnInteractionColumnReordered(DataGridColumnReorderedEventArgs<TablePayment> args)
    {
        tableInteractionMessage = string.Format(
            L["Column {0} moved from position {1} to {2}."],
            args.Column?.Title ?? string.Empty,
            args.OldIndex + 1,
            args.NewIndex + 1);
    }

    private void OnInteractionGroupChanged(DataGridColumnGroupEventArgs<TablePayment> args)
    {
        tableInteractionMessage = args.GroupDescriptor is null
            ? string.Format(L["Grouping by {0} was removed."], args.Column?.Title ?? string.Empty)
            : string.Format(L["Table grouped by {0}."], args.Column?.Title ?? string.Empty);
    }

    private void HandleRowReordered(AdmiralDataGridRowReorderEventArgs<TablePayment> args)
    {
        var currentIndex = reorderPayments.FindIndex(payment => payment.Reference == args.RowKey);
        if (currentIndex < 0)
        {
            return;
        }

        var payment = reorderPayments[currentIndex];
        reorderPayments.RemoveAt(currentIndex);
        reorderPayments.Insert(Math.Clamp(args.NewIndex, 0, reorderPayments.Count), payment);
        reorderPayments = [.. reorderPayments];
        rowReorderMessage = string.Format(
            L["Row {0} moved from position {1} to {2}."],
            args.Item.Reference,
            args.OldIndex + 1,
            args.NewIndex + 1);
    }

    private sealed record TablePayment(string Reference, string Beneficiary, decimal Amount, string Status, string Purpose);
