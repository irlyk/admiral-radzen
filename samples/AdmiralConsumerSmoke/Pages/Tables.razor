    private IReadOnlyList<TablePayment> FilteredPayments => string.IsNullOrWhiteSpace(tableSearchValue)
        ? payments
        : payments.Where(payment =>
                payment.Reference.Contains(tableSearchValue, StringComparison.OrdinalIgnoreCase) ||
                payment.Beneficiary.Contains(tableSearchValue, StringComparison.OrdinalIgnoreCase) ||
                payment.Purpose.Contains(tableSearchValue, StringComparison.OrdinalIgnoreCase) ||
                L[payment.Status].Value.Contains(tableSearchValue, StringComparison.OrdinalIgnoreCase))
            .ToArray();

